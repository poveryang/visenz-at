# 复制为 device.env 后修改（device.env 已 gitignore，勿提交密码）
#
#   cp scripts/device/device.env.example scripts/device/device.env

# ---------- SSH：登录下位机（deploy / start 用）----------
DEVICE_HOST=10.80.184.167
DEVICE_SSH_PORT=201
DEVICE_USER=root
# 留空则使用本机 SSH 密钥；填写后由脚本通过 expect 自动输入（需 brew install expect）
DEVICE_PASSWORD=


# ---------- 编译产物（相对仓库根目录）----------
# 平台子目录名，与 release/AT_v*/<PLATFORM>/ 对应
PLATFORM=imx8plus
# 若需固定某一版路径可取消注释：
# RELEASE_DIR=release/AT_v5.2.0/imx8plus

# ---------- 设备上的安装布局 ----------
REMOTE_BIN_DIR=/tmp/at_runner
REMOTE_LIB_DIR=/tmp/at_runner/lib
RUNNER_BIN_NAME=at_device_runner
# 启动 runner 时若上传了 .so，可设置库搜索路径（与 REMOTE_LIB_DIR 一致即可）
REMOTE_LD_LIBRARY_PATH=/tmp/at_runner/lib

# ---------- runner 进程参数 ----------
RUNNER_DEVICE=vs1000p_2mp
RUNNER_PORT=8080
RUNNER_LOG=/tmp/at_runner.log

# ---------- 上传策略 ----------
# auto：若 release/<platform>/lib 存在 *.so 则一并上传
# 1：强制尝试上传 lib/*.so
# 0：只上传 runner 可执行文件（当前默认交叉链为静态库，通常只需此项）
DEPLOY_SHARED_LIBS=auto

# 额外文件：相对 RELEASE_DIR 的路径，逗号分隔，格式 本地:远程
# 远程路径为设备上的绝对路径，或相对于 REMOTE_BIN_DIR 的 ../ 布局自行写绝对路径
# DEPLOY_EXTRA=lib/libfoo.so:/tmp/at_runner/lib/libfoo.so

# ---------- 冒烟测试（在上位机执行，TCP 连 DEVICE_HOST:RUNNER_PORT）----------
SMOKE_STEPS=3
# 默认与 DEVICE_HOST / RUNNER_PORT 相同；仅在端口映射/NAT 时覆盖
# SMOKE_HOST=
# SMOKE_PORT=
