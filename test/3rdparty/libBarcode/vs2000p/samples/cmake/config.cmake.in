cmake_minimum_required(VERSION 3.10)

set(PACKAGE_NAME @PROJECT_NAME@)
set(LIB_NAME @PROJECT_NAME@)
set(${PACKAGE_NAME}_VERSION ${PACKAGE_VERSION})
message(STATUS "PACKAGE_NAME = ${PACKAGE_NAME}")
@PACKAGE_INIT@

include(${CMAKE_CURRENT_LIST_DIR}/${PACKAGE_NAME}Targets.cmake)

set_and_check(${PACKAGE_NAME}_INCLUDE_DIR ${CMAKE_CURRENT_LIST_DIR}/../../../include)

set(${PACKAGE_NAME}_LIBRARIES)

list(APPEND ${PACKAGE_NAME}_LIBRARIES ${PACKAGE_NAME}::${LIB_NAME})

#### deps ####
link_directories(${CMAKE_CURRENT_LIST_DIR}/../../lib/deps)

check_required_components(${PACKAGE_NAME})