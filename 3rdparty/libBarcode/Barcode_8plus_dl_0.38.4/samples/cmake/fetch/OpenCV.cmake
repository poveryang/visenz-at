set(OpenCV_LOCAL_PATH ${CMAKE_SOURCE_DIR}/3rdparty/)
set(OPENCV_DIR "")
if(CMAKE_SYSTEM_NAME MATCHES "Linux")
    if(${CMAKE_SYSTEM_PROCESSOR} MATCHES "x86_64")
        set(OpenCV_ROOT ${OpenCV_LOCAL_PATH}/opencv_linux)
        set(OPENCV_DIR ${OpenCV_ROOT}/opencv/lib/cmake/opencv4 )
        execute_process(COMMAND bash ${CMAKE_CURRENT_SOURCE_DIR}/scripts/download_ocv.sh "linux" "${OpenCV_ROOT}")
    elseif(${PLATFORM} MATCHES "mini8")
        set(OpenCV_ROOT "${OpenCV_LOCAL_PATH}/opencv_mini8")
        set(OPENCV_DIR ${OpenCV_ROOT}/mier_opencv/lib/cmake/opencv4)
        execute_process(COMMAND bash ${CMAKE_CURRENT_SOURCE_DIR}/scripts/download_ocv.sh "mini8" "${OpenCV_ROOT}")
    elseif(${PLATFORM} MATCHES "vs600")
        set(OpenCV_ROOT "${OpenCV_LOCAL_PATH}/opencv-4.5.2-contrib-linux-aarch32")
        set(OPENCV_DIR ${OpenCV_ROOT}/opencv-4.5.2-contrib-linux-aarch32/lib/cmake/opencv4)
        execute_process(COMMAND bash ${CMAKE_CURRENT_SOURCE_DIR}/scripts/download_ocv.sh "vs600" "${OpenCV_ROOT}")
    elseif( ${PLATFORM} MATCHES "vs800")
        set(OpenCV_ROOT "${OpenCV_LOCAL_PATH}/opencv-4.5.2-contrib-linux-aarch32")
        set(OPENCV_DIR ${OpenCV_ROOT}/opencv-4.5.2-contrib-linux-aarch32/lib/cmake/opencv4)
        execute_process(COMMAND bash ${CMAKE_CURRENT_SOURCE_DIR}/scripts/download_ocv.sh "vs600" "${OpenCV_ROOT}")
    else()
        set(OpenCV_ROOT "${OpenCV_LOCAL_PATH}/opencv_aarch64")
        set(OPENCV_DIR ${OpenCV_ROOT}/opencv_aarch64/lib/cmake/opencv4 )
        execute_process(COMMAND bash ${CMAKE_CURRENT_SOURCE_DIR}/scripts/download_ocv.sh "aarch64" "${OpenCV_ROOT}")
    endif()
elseif(CMAKE_SYSTEM_NAME MATCHES "Windows")
    # set(OpenCV_ROOT "${OpenCV_LOCAL_PATH}/opencv_win")
    file(TO_NATIVE_PATH "${OpenCV_LOCAL_PATH}/opencv_win_x64" OpenCV_ROOT)
    file(TO_CMAKE_PATH ${OpenCV_ROOT}\\ OPENCV_DIR)
    if(${CMAKE_CONFIGURATION_TYPES} MATCHES "Release" OR ${CMAKE_CONFIGURATION_TYPES} MATCHES "Debug")
        execute_process(COMMAND ${CMAKE_CURRENT_SOURCE_DIR}/scripts/download_ocv.bat "${OpenCV_ROOT}" ${CMAKE_CONFIGURATION_TYPES})
    else()
        message(FATAL_ERROR "Only support config Release or Debug")
    endif()
elseif(CMAKE_SYSTEM_NAME MATCHES "Android")
    set(OpenCV_ROOT "${OpenCV_LOCAL_PATH}/opencv_android")
    set(OPENCV_DIR ${OpenCV_ROOT}/OpenCV-android-sdk/sdk/native/jni )
    execute_process(COMMAND bash ${CMAKE_CURRENT_SOURCE_DIR}/scripts/download_ocv.sh "android" "${OpenCV_ROOT}")
endif()

set(OpenCV_DIR ${OPENCV_DIR})
message("OpenCV_DIR is ${OpenCV_DIR}")
message("OPENCV_DIR is ${OPENCV_DIR}")
if("${OpenCV_DIR}" STREQUAL "")
    message(FATAL_ERROR "opencv download error")
endif()
